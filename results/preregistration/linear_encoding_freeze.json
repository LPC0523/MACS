{
  "_what": "Frozen numerical definitions and implementation for the linear-encoding feasibility simulator.",
  "_status": "IDEALIZED OFFLINE SIMULATION. Research module. Not wired into any production shim path, no serial port, no upload.",
  "_scope": "What is frozen is the mathematics and the code. It is not a general hardware capability claim: every number depends on the field maps hashed below, the region, the current bounds and both tolerances.",
  "objective": {
    "maximise": "beta_actual = d^T G i",
    "note": "The delivered gradient along d. There is no independent nominal beta and none may be reintroduced: an earlier version maximised a free beta against a relative fit error, which rewarded plain under-delivery -- a field of 1200 Hz/m sits within 10% of a 1333 Hz/m target -- and could prefer a solution delivering 900 at gain 0.7 over one delivering 1000 at gain 1.0.",
    "constraints": [
      "d^T G i >= 0",
      "||(I - d d^T) G i||_2 <= tan(theta_max) * d^T G i",
      "sqrt(mean_W[(R i)^2]) <= epsilon_nonlinear * (d^T G i) * sigma_position",
      "lower_j <= i_j <= upper_j"
    ],
    "sigma_position": "sqrt(mean_W[(d^T (r - r0))^2]), metres",
    "reduction": "Q = R^T W R / sum(W), Cholesky Q = L^T L, so the residual constraint is ||L i|| <= eps * beta * sigma. The million-row design never reaches CVXPY."
  },
  "decomposition": {
    "basis": "X = [1, x-x0, y-y0, z-z0] on the ROI, about its weighted centre",
    "per_channel": "B_j = X M_j + R_j",
    "constant_hz_per_a": "M[0]  -- reported, never counted as encoding",
    "G_hz_per_m_per_a": "M[1:4]  -- the linear part",
    "R_hz_per_a": "the nonlinear residual",
    "why_constant_excluded": "a uniform field advances every spin's phase equally and carries no position information"
  },
  "units": {
    "gamma_hz_per_t": 42577000.0,
    "gamma_hz_per_mt": 42577.0,
    "conversion": "G[mT/m] = G[Hz/m] / 42577",
    "single_entry_point": "core.linear_encoding_metrics.to_mt_per_m",
    "field_maps": "Hz/A",
    "field_unit_status": "user_confirmed",
    "time": "s",
    "current": "A",
    "field": "Hz",
    "gradient": "Hz/m",
    "phase": "rad",
    "k": "cycles/m"
  },
  "coordinates": {
    "frame": "NIfTI RAS+ world, metres",
    "x": "right(+) / left(-)",
    "y": "anterior(+) / posterior(-)",
    "z": "superior(+) / inferior(-)",
    "source": "affine only; array axes are never used as directions",
    "scanner_frame": "NOT AVAILABLE. PatientPosition and PhaseEncodingDirection are not read anywhere in this project, so RAS-Y must not be presented as the scanner phase-encoding direction."
  },
  "tolerances": {
    "theta_max_deg": {
      "meaning": "half angle of the cone on the gradient direction",
      "required": true,
      "note": "Not optional. With only a nonlinearity budget the optimum tilts hard -- 74 degrees with an orthogonal leakage 3.5x the parallel component was measured on the 12ch PFC ROI -- because the objective rewards the parallel component and the nonlinearity constraint does not penalise orthogonal linear leakage.",
      "ui_default_deg": 5.0,
      "swept": [
        2.0,
        5.0,
        10.0
      ]
    },
    "epsilon_nonlinear": {
      "meaning": "nonlinear residual RMS divided by (delivered gradient * sigma_position)",
      "required_in_every_headline": true,
      "swept": [
        0.2,
        0.3,
        0.4,
        0.5
      ]
    },
    "current_limit_a": 3.0,
    "dynamic_bounds": {
      "symmetric_bipolar": "|i_j| <= Imax - |i_static_j|",
      "asymmetric_unipolar": "[-Imax - i_static, Imax - i_static]",
      "note": "the symmetric form is the default and is what a sinusoid needs; the asymmetric window suits a single-sign blip and then the waveform must still be checked sample by sample"
    },
    "post_solve_clipping": false,
    "clipping_note": "never available. Out of bounds is answered by reject (default) or one uniform scale factor.",
    "coverage_threshold": 0.95,
    "coverage_rule": "coverage = valid sphere voxels / theoretical sphere voxels; below the threshold the region is named 'sphere and valid support', is shown as TRUNCATED, and no maximum-capability conclusion may be drawn from it"
  },
  "solver": {
    "backend": [
      "CLARABEL",
      "SCS (fallback)"
    ],
    "form": "SOCP, linear objective, second-order cones",
    "violations_measured_on_the_returned_vector": true,
    "reported_violations": [
      "box_violation_a",
      "nonlinear_constraint_relative_violation",
      "direction_cone_relative_violation"
    ],
    "monotonicity_tolerance_relative": 0.0001
  },
  "primary_metrics": [
    "gradient_parallel_actual_hz_per_m",
    "gradient_parallel_actual_mt_per_m",
    "gradient_magnitude_actual_hz_per_m",
    "direction_error_deg",
    "orthogonal_leakage_ratio",
    "nonlinear_residual_ratio",
    "nonlinear_residual_rms_hz"
  ],
  "secondary_metrics": {
    "target_fit_nrmse": "||B_centered i - beta_actual t|| / ||beta_actual t||; mixes orthogonal linear leakage with nonlinear residual and must not be used alone"
  },
  "legacy_debug_only": [
    "_legacy_requested_beta_hz_per_m"
  ],
  "waveforms": [
    "sine",
    "cosine",
    "triangle",
    "trapezoid",
    "square",
    "piecewise_linear",
    "custom_csv"
  ],
  "verification": {
    "synthetic": {
      "perfect_linear_coil": "3 A x 400 Hz/m/A delivers 1200.00 Hz/m at epsilon 0.10, 0.30 and 0.50 alike; relaxing epsilon adds no gradient",
      "adversarial": "the SOCP matches an exhaustive 25x25 grid search over the feasible box and never falls below the clean single-channel solution",
      "exact_recovery": "an exact X-gradient channel is recovered to 1e-9",
      "collinear_detection": "4 collinear channels give effective rank 1",
      "homogeneity": "doubling Imax doubles the gradient, ratios unchanged"
    },
    "monotonicity": {
      "epsilon": "6 rungs, largest relative drop 4.6e-12",
      "theta": "6 rungs, largest relative drop 0.0",
      "tolerance": 0.0001
    },
    "memory": "no (Nx, Ny, Nz, Nt) array is allocated; a 1.9 GB 4-D field peaks at 1.9 MB via B(r,t) = C(r,:) i(t)",
    "tests": [
      "test_linear_encoding_waveform.py",
      "test_linear_encoding_model.py",
      "test_linear_encoding_constraints.py",
      "test_linear_encoding_pareto.py"
    ],
    "production_smoke": "9/9"
  },
  "verified_ranges": {
